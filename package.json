{
  "name": "playwrightarc-studio",
  "version": "1.0.0",
  "description": "PlaywrightArc Studio — Playwright/Selenium test automation platform",
  "main": "server.js",
  "scripts": {
    "start":        "node server.js",
    "start:dev":    "node --watch server.js",
    "test":         "npx playwright test",
    "test:headed":  "npx playwright test --headed",
    "test:smoke":   "npx playwright test --grep @smoke",
    "test:staging": "ARC_ENVIRONMENT=staging npx playwright test",
    "test:ci":      "npx playwright test --workers=4 --retries=2",
    "report":       "npx playwright show-report",
    "install:pw":   "npx playwright install --with-deps",
    "install:all":  "npm install && npx playwright install --with-deps"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test":    "^1.42.0",
    "@types/node":         "^20.0.0",
    "typescript":          "^5.0.0",
    "adm-zip":             "^0.5.10",
    "xml2js":              "^0.6.2",
    "csv-parse":           "^5.5.6",
    "xlsx":                "^0.18.5",
    "selenium-webdriver":  "^4.18.1",
    "chromedriver":        "^123.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
